# Copie para .env (nunca versione o .env; permissão 600) e preencha. Gerar tokens e segredos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Depois de mudar o .env: docker compose up -d (recria só os contêineres afetados).
# Ao subir, a API escreve no log o que falta configurar: docker compose logs api | grep AVISO

# -- domínio e banco ---------------------------------------------------------------------------
# domínio público (DNS apontando para este servidor) e senha do Postgres local
DOMINIO=app.seudominio.com.br
POSTGRES_PASSWORD=

# -- R2 (as mesmas variáveis do lote_nuvem) ----------------------------------------------------
RENDER2GO_R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
RENDER2GO_R2_BUCKET=gpu2go
RENDER2GO_R2_ACCESS_KEY_ID=
RENDER2GO_R2_SECRET_ACCESS_KEY=

# -- segredos do serviço (32+ caracteres cada) -------------------------------------------------
RENDER2GO_SEGREDO_APROVACAO=
# chave própria das contas (códigos de entrada e o resumo dos e-mails de contas excluídas). Defina
# na 1ª subida desta versão: trocar depois deixa um e-mail de conta excluída ganhar outro teste.
RENDER2GO_SEGREDO_CONTAS=
# token fixo de worker: só para testes manuais (cada pod recebe um token próprio). Deixe vazio.
RENDER2GO_WORKER_TOKENS=

# -- painel do dono (ADR 0007): endereço secreto + token + aplicativo autenticador ---------------
# endereço do painel: /<12 a 64 letras, números, _ ou ->. Gerar:
#   python3 -c "import secrets; print('/painel-' + secrets.token_urlsafe(18))"
RENDER2GO_ADMIN_CAMINHO=
# token de entrada (32+ caracteres; vários separados por vírgula) e o 2º fator, gerado com:
#   docker compose run --rm --no-deps api render2go-servico totp-novo
RENDER2GO_ADMIN_TOKENS=
RENDER2GO_ADMIN_TOTP=
# opcional: só estes IPs ou redes abrem o painel (ex.: o IP fixo do escritório), separados por vírgula
# RENDER2GO_ADMIN_IPS=203.0.113.7,2001:db8:1234::/48

# -- e-mail: códigos de entrada e suporte (SMTP de um provedor transacional, docs/13) ------------
# sem SMTP ninguém recebe o código, e ninguém entra pelo e-mail. Escolhido: Amazon SES em Ohio
# (a região do projeto na AWS, docs/13, seção 6.1.1); usuário e senha = "SMTP credentials" do console do SES (não as chaves da AWS)
RENDER2GO_SMTP_HOST=email-smtp.us-east-2.amazonaws.com
RENDER2GO_SMTP_PORTA=587
RENDER2GO_SMTP_TLS=starttls
RENDER2GO_SMTP_USUARIO=
RENDER2GO_SMTP_SENHA=
# remetente dos códigos (domínio com SPF, DKIM e DMARC configurados, docs/13)
RENDER2GO_EMAIL_DE=Render2Go <nao-responda@seudominio.com.br>
# suporte: remetente (no SES, um endereço do domínio verificado) e para onde vão as mensagens (sem
# SUPORTE_PARA, ficam só no painel). Sem SUPORTE_DE, o suporte usa o remetente dos códigos (EMAIL_DE)
RENDER2GO_SUPORTE_DE=Render2Go Suporte <suporte@render2go.com>
RENDER2GO_SUPORTE_PARA=
# e-mails enviados ao mesmo tempo (picos de cadastro); padrão 8
# RENDER2GO_EMAIL_PARALELO=8
# domínios aceitos além da lista padrão (Gmail, Outlook/Hotmail, Yahoo, iCloud, UOL, BOL, Terra...)
# RENDER2GO_EMAIL_DOMINIOS_EXTRA=empresa-parceira.com.br

# -- "não sou um robô" (Cloudflare Turnstile): sem isto, ninguém novo entra (docs/13, seção 6.1.2) ---
RENDER2GO_TURNSTILE_SITE=
RENDER2GO_TURNSTILE_SEGREDO=
# RENDER2GO_TURNSTILE=desligado  # NUNCA em produção (só desenvolvimento local)

# -- recarga por Pix (Mercado Pago, ADR 0008): sem isto, o saldo só entra pelo painel ----------
RENDER2GO_MP_ACCESS_TOKEN=
RENDER2GO_MP_WEBHOOK_SEGREDO=
# valor de cada recarga, em reais (padrões 10 e 2000)
# RENDER2GO_RECARGA_MIN=10
# RENDER2GO_RECARGA_MAX=2000

# -- identificação do vendedor (Decreto 7.962/2013): rodapé e páginas legais -------------------
RENDER2GO_EMPRESA_NOME=
RENDER2GO_EMPRESA_DOCUMENTO=CNPJ 00.000.000/0001-00
RENDER2GO_EMPRESA_ENDERECO=
RENDER2GO_EMAIL_CONTATO=
RENDER2GO_EMAIL_PRIVACIDADE=

# -- preços do pré-pago (R$ por segundo de vídeo; docs/11) -------------------------------------
RENDER2GO_PRECO_480P_S=0,25
RENDER2GO_PRECO_720P_S=0,50

# -- escala da API (docs/13) -------------------------------------------------------------------
# processos da API (até 1 por núcleo de CPU) e conexões do banco por processo. A conta
# processos × conexões + 30 (análise e orquestrador) precisa caber no Postgres (100 conexões).
RENDER2GO_API_WORKERS=2
# RENDER2GO_DB_POOL=10

# -- orquestrador: URL pública da API (os pods chamam), chave do RunPod e limites de gasto -------
RENDER2GO_API_URL=https://app.seudominio.com.br
RUNPOD_API_KEY=
RENDER2GO_MAX_PODS=4
RENDER2GO_MAX_USD_H=10
# pods hibernados (ADR 0011): voltam em ~1 min em vez de 4-5 min; ~US$ 14/mês cada, parados. O pod parado só
# volta no mesmo host: se a GPU dele foi alugada por outra pessoa, sobe um pod do zero (o painel mostra o motivo)
# RENDER2GO_PODS_HIBERNADOS=2
# escolha do host (12/10/2026): a 1ª tentativa de cada subida pede ao RunPod máquina com download e disco
# medidos acima disto (megabits/s e megabytes/s; 0 desliga); sem vaga, tenta sem os filtros. Os datacenters
# vão na ordem da velocidade medida nos downloads de verdade (memória no volume do orquestrador)
# RENDER2GO_REDE_MIN_MBPS=2000
# RENDER2GO_DISCO_MIN_MBS=1000
# RENDER2GO_PRAZO_MIN=20   # opcional: entregar em N min (mais pods, custa mais)
# testes gratuitos esperam juntar N vídeos ou M minutos antes de subir um pod (padrões 20 e 10)
# RENDER2GO_AGRUPAR_TESTE_VIDEOS=20
# RENDER2GO_AGRUPAR_TESTE_MIN=10
# teste gratuito: teto de fotos por IP somando todos os clientes de teste; 0 = sem teto (o padrão desde
# 11/10/2026). O limite por dispositivo (5 fotos) continua
# RENDER2GO_TESTE_FOTOS_IP=0
# o cliente vê "em análise: começa em até N min" (ajuste ao seu ritmo de revisão)
# RENDER2GO_PRAZO_REVISAO_MIN=60

# -- filtro de imagem (ADR 0005): fotos no servidor, antes de qualquer pod, e quadros do vídeo no pod -----------
# a mesma regra nos dois: barra com a nota (P(medium) + P(high), na média de 2 quadros seguidos; numa foto, a
# própria foto) a partir de LIMIAR, ou com a nota explícita (P(high)) a partir de LIMIAR_ALTO. Só dentro dos limites
# (0,3–0,8 e 0,2–0,6): o filtro nunca é desligado por aqui. Padrões 0,5 e 0,35
# RENDER2GO_FILTRO_LIMIAR=0,5
# RENDER2GO_FILTRO_LIMIAR_ALTO=0,35
# threads de CPU do filtro das fotos no analisador (padrão 1: ~2 s por imagem; 2: ~1,2 s, disputando a CPU com a API)
# RENDER2GO_FILTRO_THREADS=1
