# Copie para .env (nunca versione o .env) e preencha. Gerar tokens/segredos:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# domínio público (DNS apontando para este servidor) e senha do Postgres local
DOMINIO=videos.seudominio.com.br
POSTGRES_PASSWORD=

# R2 (as mesmas variáveis do lote_nuvem)
GPU2GO_R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com
GPU2GO_R2_BUCKET=gpu2go
GPU2GO_R2_ACCESS_KEY_ID=
GPU2GO_R2_SECRET_ACCESS_KEY=

# segredos do serviço (32+ caracteres cada)
GPU2GO_SEGREDO_APROVACAO=
GPU2GO_ADMIN_TOKENS=
GPU2GO_WORKER_TOKENS=

# orquestrador: URL pública da API (os pods chamam), chave do RunPod e limites de gasto
GPU2GO_API_URL=https://videos.seudominio.com.br
RUNPOD_API_KEY=
GPU2GO_MAX_PODS=4
GPU2GO_MAX_USD_H=10
# GPU2GO_PRAZO_MIN=20   # opcional: entregar em N min (mais pods, custa mais)
# testes gratuitos esperam juntar N vídeos ou M minutos antes de subir um pod (padrões 20 e 10)
# GPU2GO_AGRUPAR_TESTE_VIDEOS=20
# GPU2GO_AGRUPAR_TESTE_MIN=10
# teste gratuito: fotos por IP somando todos os clientes de teste (o limite por dispositivo é 10)
# GPU2GO_TESTE_FOTOS_IP=50
